  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "7b1a5d47-6c5d-4c53-b2ac-796b6a982970",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x500 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "df_clean = pd.read_csv(\"gta6_id_streamers_clean.csv\")\n",
    "df_clean[\"engagement_rate_pct\"] = (\n",
    "    (df_clean[\"likes\"] + df_clean[\"comments\"])\n",
    "    / df_clean[\"total_views\"].replace(0, pd.NA)\n",
    ") * 100\n",
    "\n",
    "summary_df = (\n",
    "    df_clean.groupby(\"streamer_name\")\n",
    "    .agg(\n",
    "        jumlah_video=(\"video_id\", \"count\"),\n",
    "        total_views=(\"total_views\", \"sum\"),\n",
    "        rata_views=(\"total_views\", \"mean\"),\n",
    "        rata_durasi_mnt=(\"duration_minutes\", \"mean\"),\n",
    "        rata_engagement_pct=(\"engagement_rate_pct\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"rata_views\", ascending=True)\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
    "\n",
    "axes[0].barh(\n",
    "    summary_df.index, summary_df[\"rata_views\"] / 1e6, color=\"#2563eb\"\n",
    ")\n",
    "axes[0].set_title(\"Rata-rata Views (Juta)\")\n",
    "axes[0].set_xlabel(\"Juta Views\")\n",
    "for idx, val in enumerate(summary_df[\"rata_views\"] / 1e6):\n",
    "  axes[0].text(val + 0.08, idx, f\"{val:.2f}M\", va=\"center\", fontsize=9)\n",
    "\n",
    "eng_sorted = summary_df.sort_values(\"rata_engagement_pct\", ascending=True)\n",
    "axes[1].barh(\n",
    "    eng_sorted.index, eng_sorted[\"rata_engagement_pct\"], color=\"#16a34a\"\n",
    ")\n",
    "axes[1].set_title(\"Rata-rata Engagement Rate (%)\")\n",
    "axes[1].set_xlabel(\"Engagement (%)\")\n",
    "for idx, val in enumerate(eng_sorted[\"rata_engagement_pct\"]):\n",
    "  axes[1].text(val + 0.04, idx, f\"{val:.2f}%\", va=\"center\", fontsize=9)\n",
    "\n",
    "axes[2].scatter(\n",
    "    df_clean[\"published_hour_wib\"],\n",
    "    df_clean[\"total_views\"] / 1e6,\n",
    "    s=df_clean[\"duration_minutes\"] * 0.8,\n",
    "    alpha=0.75,\n",
    "    color=\"#d97706\",\n",
    ")\n",
    "for _, row in df_clean.iterrows():\n",
    "  axes[2].annotate(\n",
    "      row[\"streamer_name\"].split()[0],\n",
    "      (row[\"published_hour_wib\"], row[\"total_views\"] / 1e6),\n",
    "      textcoords=\"offset points\",\n",
    "      xytext=(0, 6),\n",
    "      ha=\"center\",\n",
    "      fontsize=8,\n",
    "  )\n",
    "axes[2].set_title(\"Jam Rilis WIB vs Views (Ukuran = Durasi)\")\n",
