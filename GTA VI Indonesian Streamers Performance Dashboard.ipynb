   "source": [
    "import csv\n",
    "import pandas as pd\n",
    "\n",
    "df_clean = pd.read_csv(\"gta6_id_streamers_clean_looker.csv\")\n",
    "\n",
    "if \"engagement_rate_pct\" not in df_clean.columns:\n",
    "  df_clean[\"engagement_rate_pct\"] = (\n",
    "      (df_clean[\"likes\"] + df_clean[\"comments\"])\n",
    "      / df_clean[\"total_views\"].replace(0, pd.NA)\n",
    "  ) * 100\n",
    "if \"views_millions\" not in df_clean.columns:\n",
    "  df_clean[\"views_millions\"] = df_clean[\"total_views\"] / 1e6\n",
    "if \"duration_hours\" not in df_clean.columns:\n",
    "  df_clean[\"duration_hours\"] = df_clean[\"duration_minutes\"] / 60\n",
    "\n",
    "df_clean[\"published_date\"] = (\n",
    "    pd.to_datetime(df_clean[\"published_date\"], errors=\"coerce\")\n",
    "    .dt.strftime(\"%Y-%m-%d\")\n",
    "    .fillna(\"\")\n",
    ")\n",
    "\n",
    "num_cols = [\n",
    "    \"published_hour_wib\",\n",
    "    \"duration_minutes\",\n",
    "    \"total_views\",\n",
    "    \"likes\",\n",
    "    \"comments\",\n",
    "    \"engagement_rate_pct\",\n",
    "    \"views_millions\",\n",
    "    \"duration_hours\",\n",
    "]\n",
    "for col in num_cols:\n",
    "  if col in df_clean.columns:\n",
    "    df_clean[col] = pd.to_numeric(df_clean[col], errors=\"coerce\").fillna(0)\n",
    "\n",
    "for col in [\"video_id\", \"streamer_name\", \"video_title\"]:\n",
    "  if col in df_clean.columns:\n",
    "    df_clean[col] = (\n",
    "        df_clean[col]\n",
    "        .astype(str)\n",
    "        .str.replace(r\"[\\r\\n]+\", \" \", regex=True)\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "output_csv = \"gta6_id_streamers_clean_looker_clean.csv\"\n",
    "df_clean.to_csv(\n",
    "    output_csv,\n",
    "    index=False,\n",
    "    encoding=\"utf-8-sig\",\n",
    "    quoting=csv.QUOTE_NONNUMERIC,\n",
    ")\n",
    "\n",
    "print(\"Berhasil disimpan ke:\", output_csv, \"| Jumlah baris:\", len(df_clean))"
   ]
