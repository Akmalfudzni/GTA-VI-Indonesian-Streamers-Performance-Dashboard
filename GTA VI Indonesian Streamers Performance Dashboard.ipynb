   "source": [
    "from datetime import datetime\n",
    "import re\n",
    "from googleapiclient.discovery import build\n",
    "import isodate\n",
    "import pandas as pd\n",
    "import pytz\n",
    "\n",
    "API_KEY = \"YOUR API"\,
    "\n",
    "CHANNEL_IDS = {\n",
    "    \"Windah Basudara\": \"UCoIiiHof6BJ85PLuLkuxuhw\",\n",
    "    \"Luthfi Halimawan\": \"UCrEj4d2ynysNsYttTYROXEg\",\n",
    "    \"set1awanade\": \"UCTH2fnE15t_SDeaLGkcLZ3Q\",\n",
    "    \"DEANKT\": \"UC0KlWYEQIlR2KHS_dHfKJhA\",\n",
    "    # Tambahkan streamer lain di bawah ini jika mau:\n",
    "    # \"Streamer Lain\": \"UC...\",\n",
    "}\n",
    "\n",
    "KEYWORDS = [\"gta 6\", \"gta vi\", \"grand theft auto vi\", \"grand theft auto 6\"]\n",
    "WIB = pytz.timezone(\"Asia/Jakarta\")\n",
    "\n",
    "youtube = build(\"youtube\", \"v3\", developerKey=API_KEY)\n",
    "print(\"Konfigurasi berhasil dimuat.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "945af4e6-20b2-47ff-be1d-c9e634b3635d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Helper functions siap.\n"
     ]
    }
   ],
   "source": [
    "def matches_gta6(title: str, description: str) -> bool:\n",
    "  text = f\"{title} {description}\".lower()\n",
    "  return any(\n",
    "      re.search(rf\"\\b{re.escape(kw)}\\b\", text) for kw in KEYWORDS\n",
    "  )\n",
    "\n",
    "\n",
    "def get_uploads_playlist_id(channel_id: str) -> str | None:\n",
    "  res = youtube.channels().list(part=\"contentDetails\", id=channel_id).execute()\n",
    "  items = res.get(\"items\", [])\n",
    "  if not items:\n",
    "    return None\n",
    "  return items[0][\"contentDetails\"][\"relatedPlaylists\"][\"uploads\"]\n",
    "\n",
    "\n",
    "def get_recent_upload_video_ids(\n",
    "    playlist_id: str, max_pages: int = 2\n",
    ") -> list[str]:\n",
    "  video_ids = []\n",
    "  next_page_token = None\n",
    "\n",
    "  for _ in range(max_pages):\n",
    "    res = (\n",
    "        youtube.playlistItems()\n",
    "        .list(\n",
    "            part=\"contentDetails\",\n",
    "            playlistId=playlist_id,\n",
    "            maxResults=50,\n",
    "            pageToken=next_page_token,\n",
    "        )\n",
    "        .execute()\n",
    "    )\n",
    "    for item in res.get(\"items\", []):\n",
    "      video_ids.append(item[\"contentDetails\"][\"videoId\"])\n",
    "    next_page_token = res.get(\"nextPageToken\")\n",
    "    if not next_page_token:\n",
    "      break\n",
    "\n",
    "  return video_ids\n",
    "\n",
    "\n",
    "def parse_duration_minutes(iso_duration: str) -> float:\n",
    "  if not iso_duration:\n",
    "    return 0.0\n",
    "  try:\n",
    "    delta = isodate.parse_duration(iso_duration)\n",
    "    return round(delta.total_seconds() / 60.0, 2)\n",
    "  except Exception:\n",
    "    return 0.0\n",
    "\n",
    "\n",
    "print(\"Helper functions siap.\")"
   ]
  },
