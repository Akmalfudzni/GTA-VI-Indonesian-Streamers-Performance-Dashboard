   "source": [
    "rows = []\n",
    "\n",
    "for streamer_name, channel_id in CHANNEL_IDS.items() :\n",
    "  if not channel_id or channel_id.startswith(\"UC...\") or len(channel_id) < 10:\n",
    "    print(f\"[SKIP] Channel ID belum diisi valid untuk: {streamer_name}\")\n",
    "    continue\n",
    "\n",
    "  uploads_id = get_uploads_playlist_id(channel_id)\n",
    "  if not uploads_id:\n",
    "    print(f\"[WARN] Channel tidak ditemukan: {streamer_name} ({channel_id})\")\n",
    "    continue\n",
    "\n",
    "  candidate_ids = get_recent_upload_video_ids(uploads_id, max_pages=2)\n",
    "  if not candidate_ids:\n",
    "    print(f\"[INFO] Tidak ada video di playlist uploads: {streamer_name}\")\n",
    "    continue\n",
    "\n",
    "  for i in range(0, len(candidate_ids), 50):\n",
    "    batch_ids = candidate_ids[i : i + 50]\n",
    "    res = (\n",
    "        youtube.videos()\n",
    "        .list(\n",
    "            part=\"snippet,contentDetails,statistics,liveStreamingDetails\",\n",
    "            id=\",\".join(batch_ids),\n",
    "        )\n",
    "        .execute()\n",
    "    )\n",
    "\n",
    "    for vid in res.get(\"items\", []):\n",
    "      snippet = vid.get(\"snippet\", {})\n",
    "      title = snippet.get(\"title\", \"\")\n",
    "      description = snippet.get(\"description\", \"\")\n",
    "\n",
    "      if not matches_gta6(title, description):\n",
    "        continue\n",
    "\n",
    "      live_details = vid.get(\"liveStreamingDetails\", {})\n",
    "      raw_time = live_details.get(\"actualStartTime\") or snippet.get(\n",
    "          \"publishedAt\"\n",
    "      )\n",
    "      dt_utc = datetime.fromisoformat(raw_time.replace(\"Z\", \"+00:00\"))\n",
    "      dt_wib = dt_utc.astimezone(WIB)\n",
    "\n",
    "      stats = vid.get(\"statistics\", {})\n",
    "      duration_mins = parse_duration_minutes(\n",
    "          vid.get(\"contentDetails\", {}).get(\"duration\", \"\")\n",
    "      )\n",
    "\n",
    "      rows.append({\n",
    "          \"video_id\": vid.get(\"id\"),\n",
    "          \"streamer_name\": streamer_name,\n",
    "          \"video_title\": title,\n",
    "          \"published_date\": dt_wib.strftime(\"%Y-%m-%d\"),\n",
    "          \"published_hour_wib\": dt_wib.hour,\n",
    "          \"duration_minutes\": duration_mins,\n",
    "          \"peak_viewers\": None,\n",
    "          \"total_views\": int(stats.get(\"viewCount\", 0)),\n",
    "          \"likes\": int(stats.get(\"likeCount\", 0)),\n",
    "          \"comments\": int(stats.get(\"commentCount\", 0)),\n",
    "      })\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "display(df.head(10))\n",
    "\n",
    "output_file = \"gta6_id_streamers_raw.csv\"\n",
    "df.to_csv(output_file, index=False, encoding=\"utf-8-sig\")\n",
    "print(f\"Selesai! Total {len(df)} baris tersimpan ke {output_file}\")"
   ]
  },
